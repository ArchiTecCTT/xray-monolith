// R1 thermal look, step 3: the thermal picture as one grey value per sensor pixel.
//   world : the scene's brightness squeezed into a narrow grey band, with a gain in the dark; the sky near black
//   bodies: hotness as brightness (the heat ladder: a living body stays under fire), darker towards their edges
//           (the edge term), a thin dark ring right outside them and a faint glow around them; fire blooms
//   sensor: moving grain, a fixed column pattern, faint lines
// Every strength is a console var (r1_thermal_*), see docs/r1_thermal.md in the engine repo.
uniform sampler2D s_scene; // the scene
uniform sampler2D s_down;  // the heat mask at sensor size: r hotness, b sky, a edge term
uniform sampler2D s_glow;  // its blur
uniform sampler2D s_noise;
uniform float4 thermal_tap_a;    // scene taps: xy = the step along one diagonal (four taps cover one sensor pixel)
uniform float4 thermal_tap_b;    //             xy = along the other
uniform float4 thermal_ring_a;   // ring taps: xy = one sensor pixel along one diagonal
uniform float4 thermal_ring_b;   //            xy = along the other
uniform float4 thermal_body;     // x = edge darkening, y = ring, z = glow, w = level of heat 1 where it faces the camera
uniform float4 thermal_hot;      // x = bloom of the very hot (fire)
uniform float4 thermal_world;    // x = base level, y = contrast, z = gamma
uniform float4 thermal_night;    // the world in the dark: x = gain g, y = (1 - 1 / g) / (the top a lit patch can reach)^2,
                                 // z = extra grain of the world under gain. (1, 0, 0) = none
uniform float4 thermal_sky;      // x = sky level, y = how much of the clouds stays
uniform float4 thermal_grain;    // x = grain, y = column pattern, z = lines, w = half the sensor height in pixels
uniform float4 thermal_noise_a;  // xy = noise texels per picture
uniform float4 thermal_noise_b;  // xy = this frame's shift of the grain
uniform float4 thermal_col_a;    // x = noise texels per picture width, y = 0
uniform float4 thermal_col_b;    // x = 0, y = the noise row the column pattern is read from

float4 main(float2 tc : TEXCOORD0) : COLOR0
{
    float3 s = tex2D(s_scene, tc + thermal_tap_a.xy).rgb;
    s += tex2D(s_scene, tc - thermal_tap_a.xy).rgb;
    s += tex2D(s_scene, tc + thermal_tap_b.xy).rgb;
    s += tex2D(s_scene, tc - thermal_tap_b.xy).rgb;
    float lum = dot(s, float3(0.07475, 0.14675, 0.0285));
    float4 n = tex2D(s_noise, tc * thermal_noise_a.xy + thermal_noise_b.xy);
    // a thermal sight sees heat, not light: in the dark the world gets a gain (r1_thermal_night). Dark things get all
    // of it, bright ones (a lamp's pool of light) bend over towards a top level. The grain hides the few steps a dark
    // 8-bit frame is made of. With thermal_night = (1, 0, 0) lum stays exactly what it was.
    lum = (lum + n.r * thermal_night.z) * thermal_night.x;
    lum *= rsqrt(1.0 + thermal_night.y * lum * lum);

    float4 m = tex2D(s_down, tc);
    float around = tex2D(s_down, tc + thermal_ring_a.xy).r;
    around += tex2D(s_down, tc - thermal_ring_a.xy).r;
    around += tex2D(s_down, tc + thermal_ring_b.xy).r;
    around += tex2D(s_down, tc - thermal_ring_b.xy).r;
    float4 glow = tex2D(s_glow, tc); // r = heat around, g = the very hot around

    float world = thermal_world.x + thermal_world.y * pow(lum, thermal_world.z);
    float sky = thermal_sky.x + thermal_sky.y * lum;
    // squared: a thin thing against the sky (a cable, a pylon) covers part of the sensor pixel and still shows
    float v = lerp(world, sky, m.b * m.b);
    v *= 1.0 - thermal_body.y * max(around * 0.25 - m.r, 0.0);
    v += thermal_body.z * glow.r * (1.0 - m.r);
    v = lerp(v, thermal_body.w - thermal_body.x * m.a, m.r);
    v += thermal_hot.x * glow.g;

    float column = tex2D(s_noise, tc * thermal_col_a.xy + thermal_col_b.xy).b;
    v += (n.r + n.g - 1.0) * thermal_grain.x;
    v += (column - 0.5) * thermal_grain.y;
    v += (frac(tc.y * thermal_grain.w) - 0.5) * thermal_grain.z;
    return float4(v, v, v, 1.0);
}
