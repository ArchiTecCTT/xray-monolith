// R1 thermal test look (r1_thermal_demo 1): the world in grey, warm bodies white. Hotness is brightness, so a
// cooling corpse fades into the grey. A plain test picture drawn by the engine in place of postprocess.ps while
// r__heatvision is on; the look a mod wants belongs in that mod's own post-process shader (docs/r1_thermal.md).
uniform sampler2D s_base0; // the scene ($user$rendertarget)
uniform sampler2D s_heat;  // the heat mask ($user$heat): r = hotness, g = 1 on the player's hands

float4 main(float2 tc : TEXCOORD0) : COLOR0
{
    float3 scene = tex2D(s_base0, tc).rgb;
    float heat = tex2D(s_heat, tc).r;
    float grey = dot(scene, float3(0.299, 0.587, 0.114)) * 0.6;
    float3 look = lerp(float3(grey, grey, grey), float3(1.0, 1.0, 1.0), heat);
    return float4(look, 1.0);
}
