// R1 thermal (r__heatvision): what a warm visual writes into the heat mask ($user$heat, $user$heat_vp2).
// Red = hotness 0..1 from the vertex shader (see the heat ladder in docs/r1_thermal.md in the engine repo), green = 1
// for the player's hands (r1_heat_item.y, set by the engine per visual), alpha = the edge term: 0 where the surface
// faces the camera, 1 where it is seen edge-on.
uniform float4 r1_heat_item;

float4 main(float2 tc : TEXCOORD0, float2 heat : TEXCOORD1) : COLOR0
{
    return float4(heat.y, r1_heat_item.y, 0.0, saturate(1.0 - heat.x));
}
