// R1 thermal look, step 2 (run twice): a small blur of the sensor-size heat, at half that size. The result is the
// glow around hot things.
uniform sampler2D s_image;
uniform float4 thermal_tap; // xy, zw = the two diagonal tap steps

float4 main(float2 tc : TEXCOORD0) : COLOR0
{
    float4 m = tex2D(s_image, tc);
    m += tex2D(s_image, tc + thermal_tap.xy);
    m += tex2D(s_image, tc - thermal_tap.xy);
    m += tex2D(s_image, tc + thermal_tap.zw);
    m += tex2D(s_image, tc - thermal_tap.zw);
    return m * 0.2;
}
